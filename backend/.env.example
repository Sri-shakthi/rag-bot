PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_web_client_id
# Optional comma-separated list when you support multiple frontends:
# GOOGLE_CLIENT_IDS=id1.apps.googleusercontent.com,id2.apps.googleusercontent.com
AUTH_JWT_SECRET=replace_with_a_long_random_secret
AUTH_COOKIE_NAME=rag_auth
AUTH_COOKIE_MAX_AGE_MS=864000000
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1024
GEMINI_CHAT_MODEL=gemini-2.5-flash
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=your_pinecone_index_name
PINECONE_NAMESPACE=legal-cases
DATABASE_URL=mysql://root:root@mysql:3306/ragdb
SIMILARITY_THRESHOLD=0.45
TOP_K=5
HISTORY_PAIRS=5
